#!/usr/bin/env node
// Stop hook: in a session that ran the `start` skill, blocks the finish once
// when the tree has code changes and the final message has no security gate
// section. Silent in every other session, and never blocks twice in a row.

const { readFileSync } = require('node:fs');
const { spawnSync } = require('node:child_process');

const START_SKILL = /^(?:[\w-]+:)?start$/;
const GATE = /security gate/i;
const NOT_CODE = /\.(md|txt)$|^\.engineering\//;

function lines(text) {
  return text.split('\n').filter(Boolean).flatMap((l) => {
    try { return [JSON.parse(l)]; } catch { return []; }
  });
}

function blocks(entry) {
  const content = entry?.message?.content;
  return Array.isArray(content) ? content : [];
}

function ranStart(entries) {
  return entries.some((e) => blocks(e).some((b) => b.type === 'tool_use' && b.name === 'Skill' && START_SKILL.test(b.input?.skill ?? '')));
}

function lastAssistantText(entries) {
  for (let i = entries.length - 1; i >= 0; i--) {
    if (entries[i].type !== 'assistant') continue;
    const text = blocks(entries[i]).filter((b) => b.type === 'text').map((b) => b.text).join('\n');
    if (text) return text;
  }
  return '';
}

function changedCode(dir) {
  const status = spawnSync('git', ['-C', dir, 'status', '--porcelain'], { encoding: 'utf8' });
  if (status.status !== 0) return false;
  return status.stdout.split('\n').filter(Boolean)
    .map((l) => l.slice(3).replace(/^.* -> /, ''))
    .some((path) => !NOT_CODE.test(path));
}

let input = {};
try { input = JSON.parse(readFileSync(0, 'utf8')); } catch { process.exit(0); }

let entries = [];
try { entries = lines(readFileSync(input.transcript_path, 'utf8')); } catch { process.exit(0); }

if (!ranStart(entries)) process.exit(0);
if (!changedCode(process.env.CLAUDE_PROJECT_DIR || process.cwd())) process.exit(0);

const message = typeof input.last_assistant_message === 'string' ? input.last_assistant_message : lastAssistantText(entries);
if (GATE.test(message)) process.exit(0);

if (input.stop_hook_active) {
  console.log(JSON.stringify({ systemMessage: 'The security gate is still missing from the final report after one reminder. Tell the user the change did not go through the gate.' }));
  process.exit(0);
}

console.log(JSON.stringify({
  decision: 'block',
  reason: 'This session ran `start` and changed code, but the final message has no "Security gate" section. Run the six-line security gate from the start skill on the full diff and put its answers in the report before finishing. A line you cannot answer is a failed line: fix it or tell the user why it is open.',
}));

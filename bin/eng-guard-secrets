#!/bin/sh
# PreToolUse hook for Bash: asks the user before a shell command touches a
# secret file. Permission deny rules cover Claude's file tools, not `cat .env`.
# Reads the hook JSON on stdin; prints a hook decision only when it asks.

command=$(awk 'BEGIN { RS = "\001" } {
  i = index($0, "\"command\""); if (!i) exit
  s = substr($0, i + 9); s = substr(s, index(s, "\"") + 1)
  out = ""; esc = 0
  for (k = 1; k <= length(s); k++) {
    c = substr(s, k, 1)
    if (esc) { out = out c; esc = 0; continue }
    if (c == "\\") { esc = 1; out = out c; continue }
    if (c == "\"") break
    out = out c
  }
  print out
}')
[ -n "$command" ] || exit 0

before='(^|[[:space:]"'"'"'/=(<\\])'
name='(\.env(\.[A-Za-z0-9_-]+)?|[A-Za-z0-9_.-]*\.(pem|key|pfx|p12)|id_(rsa|ecdsa|ed25519)|secrets\.json|\.aws/credentials|\.kube/config|\.git-credentials|\.npmrc|\.pypirc)'
after='($|[[:space:]"'"'"';|)>&\\])'
hits=$(printf '%s\n' "$command" | grep -oE "$before$name$after" | sed -E 's/^[[:space:]"'"'"'/=(<\\]//; s/[[:space:]"'"'"';|)>&\\]$//' \
  | grep -vE '^\.env\.(example|sample|template|dist|defaults)$' | sort -u | tr '\n' ' ' | sed 's/ $//')
[ -n "$hits" ] || exit 0

printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"ask","permissionDecisionReason":"This command touches a secret file (%s). The engineering harness asks before reading or sending secrets."}}\n' "$hits"

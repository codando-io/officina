#!/usr/bin/env node
// Records a browser journey as a GIF for a pull request's before and after
// block, and uploads a body's local images to a Forgejo pull request.
// Procedure: skills/test/references/ui-evidence.md.
'use strict';

const { spawnSync } = require('node:child_process');
const fs = require('node:fs');
const os = require('node:os');
const path = require('node:path');
const { createRequire } = require('node:module');
const { pathToFileURL } = require('node:url');

const PLAYWRIGHT = 'playwright-core@1.64.1';
const GITHUB_IMAGE_LIMIT = 10 * 1024 * 1024;
const cacheDir = path.join(process.env.XDG_CACHE_HOME || path.join(os.homedir(), '.cache'), 'officina', 'ui-gif');

const usage = `usage:
  ui-gif record --url <base url> --out <file.gif> [--journey <file.mjs>] [--path /]
                [--viewport 1280x800] [--width 960] [--fps 10]
                [--color-scheme light|dark] [--browser chrome|chromium]
  ui-gif forgejo-attach --repo https://<host>/<owner>/<repo> --pr <number> --body-file <file.md>`;

function fail(message, code = 1) {
  process.stderr.write(`ui-gif: ${message}\n`);
  process.exit(code);
}

function options(argv) {
  const parsed = {};
  for (let i = 0; i < argv.length; i += 2) {
    const flag = argv[i];
    if (!flag.startsWith('--') || argv[i + 1] === undefined) fail(`expected --flag value pairs, got "${flag}"\n${usage}`, 2);
    parsed[flag.slice(2)] = argv[i + 1];
  }
  return parsed;
}

function required(parsed, names) {
  const missing = names.filter((name) => !parsed[name]);
  if (missing.length) fail(`missing ${missing.map((m) => `--${m}`).join(', ')}\n${usage}`, 2);
}

function loadPlaywright() {
  for (const from of [process.cwd(), cacheDir]) {
    try {
      return createRequire(path.join(from, 'package.json'))('playwright-core');
    } catch {}
  }
  fail(`playwright-core is not installed. Install the pinned version once, outside any project:
  npm install --prefix "${cacheDir}" --save-exact --ignore-scripts --no-audit --no-fund ${PLAYWRIGHT}`, 3);
}

function ffmpeg(tool, args) {
  const result = spawnSync(tool, ['-hide_banner', '-loglevel', 'error', ...args], { encoding: 'utf8' });
  if (result.error && result.error.code === 'ENOENT') fail(`${tool} is not on PATH (brew install ffmpeg, apt install ffmpeg)`, 3);
  if (result.status !== 0) fail(`${tool} failed: ${result.stderr.trim()}`);
  return result.stdout;
}

async function defaultJourney(page, route) {
  await page.goto(route, { waitUntil: 'load' });
  await page.waitForTimeout(1200);
  const distance = await page.evaluate(() => Math.min(document.documentElement.scrollHeight - innerHeight, innerHeight * 3));
  for (let done = 0; done < distance; done += 80) {
    await page.mouse.wheel(0, 80);
    await page.waitForTimeout(50);
  }
  await page.waitForTimeout(1000);
}

async function record(parsed) {
  required(parsed, ['url', 'out']);
  if (!parsed.out.endsWith('.gif')) fail('--out must end in .gif', 2);
  const [width, height] = (parsed.viewport || '1280x800').split('x').map(Number);
  if (!width || !height) fail('--viewport must look like 1280x800', 2);
  const fps = Number(parsed.fps || 10);
  const scale = Number(parsed.width || Math.min(width, 960));
  ffmpeg('ffmpeg', ['-version']);

  let journey = (page) => defaultJourney(page, parsed.path || '/');
  if (parsed.journey) {
    const loaded = await import(pathToFileURL(path.resolve(parsed.journey)).href);
    journey = loaded.default || loaded;
    if (typeof journey !== 'function') fail(`${parsed.journey} must export a function (page) => Promise`, 2);
  }

  const { chromium } = loadPlaywright();
  const browser = await chromium.launch(parsed.browser === 'chromium' ? {} : { channel: 'chrome' });
  const context = await browser.newContext({
    baseURL: parsed.url,
    viewport: { width, height },
    deviceScaleFactor: 1,
    colorScheme: parsed['color-scheme'] || 'light',
  });
  const page = await context.newPage();
  const cdp = await context.newCDPSession(page);
  const shots = [];
  cdp.on('Page.screencastFrame', ({ data, sessionId }) => {
    if (page.url() !== 'about:blank') shots.push({ data, at: Date.now() });
    cdp.send('Page.screencastFrameAck', { sessionId }).catch(() => {});
  });
  await cdp.send('Page.startScreencast', { format: 'jpeg', quality: 90, maxWidth: width, maxHeight: height });
  try {
    await journey(page);
    await page.waitForTimeout(800);
    await cdp.send('Page.stopScreencast');
  } finally {
    await context.close();
    await browser.close();
  }
  if (!shots.length) fail('the journey never showed a page; it must navigate, for example await page.goto("/")');
  shots.push({ ...shots[shots.length - 1], at: Date.now() });

  const work = fs.mkdtempSync(path.join(os.tmpdir(), 'ui-gif-'));
  const list = ['ffconcat version 1.0'];
  shots.forEach((shot, i) => {
    const file = path.join(work, `${String(i).padStart(5, '0')}.jpg`);
    fs.writeFileSync(file, Buffer.from(shot.data, 'base64'));
    list.push(`file '${file}'`);
    if (i < shots.length - 1) list.push(`duration ${Math.max(0.01, (shots[i + 1].at - shot.at) / 1000).toFixed(3)}`);
  });
  fs.writeFileSync(path.join(work, 'frames.txt'), `${list.join('\n')}\n`);

  const out = path.resolve(parsed.out);
  ffmpeg('ffmpeg', ['-y', '-f', 'concat', '-safe', '0', '-i', path.join(work, 'frames.txt'), '-vf',
    `fps=${fps},scale=${scale}:-1:flags=lanczos,split[a][b];[a]palettegen[p];[b][p]paletteuse=dither=bayer:bayer_scale=5:diff_mode=rectangle`,
    '-loop', '0', out]);
  fs.rmSync(work, { recursive: true, force: true });

  const count = Number(ffmpeg('ffprobe', ['-count_frames', '-select_streams', 'v:0', '-show_entries', 'stream=nb_read_frames', '-of', 'csv=p=0', out]).trim());
  const framesDir = out.replace(/\.gif$/, '-frames');
  fs.rmSync(framesDir, { recursive: true, force: true });
  fs.mkdirSync(framesDir);
  const picks = [...new Set([0, Math.floor(count / 2), count - 1])];
  ffmpeg('ffmpeg', ['-i', out, '-vf', `select='${picks.map((n) => `eq(n\\,${n})`).join('+')}'`, '-fps_mode', 'passthrough', path.join(framesDir, 'frame-%d.png')]);
  const frames = fs.readdirSync(framesDir).sort().map((f) => path.join(framesDir, f));

  const bytes = fs.statSync(out).size;
  if (bytes > GITHUB_IMAGE_LIMIT) process.stderr.write(`ui-gif: ${out} is ${(bytes / 1048576).toFixed(1)} MB; GitHub refuses images over 10 MB. Shorten the journey or lower --fps or --width.\n`);
  process.stdout.write(`${JSON.stringify({ gif: out, bytes, seconds: Number((count / fps).toFixed(1)), frames }, null, 2)}\n`);
}

const MIME = { '.gif': 'image/gif', '.png': 'image/png', '.jpg': 'image/jpeg', '.jpeg': 'image/jpeg', '.webp': 'image/webp', '.mp4': 'video/mp4', '.webm': 'video/webm' };

async function forgejoAttach(parsed) {
  required(parsed, ['repo', 'pr', 'body-file']);
  const token = process.env.FORGEJO_TOKEN;
  if (!token) fail('FORGEJO_TOKEN is not set. Create a token with the write:issue scope in the forge user settings and export it, or attach the files by hand.', 3);
  const repo = parsed.repo.match(/^(https?:\/\/[^/]+)\/([^/]+)\/([^/]+?)(?:\.git)?\/?$/);
  if (!repo) fail('--repo must look like https://<host>/<owner>/<repo>', 2);
  const [, origin, owner, name] = repo;
  const bodyFile = path.resolve(parsed['body-file']);
  let body = fs.readFileSync(bodyFile, 'utf8');

  const local = [...body.matchAll(/!\[[^\]]*\]\(([^)\s]+)\)/g)]
    .map((m) => m[1])
    .filter((target) => !/^[a-z][a-z0-9+.-]*:/i.test(target) && !target.startsWith('/') && !target.startsWith('#'));
  for (const target of new Set(local)) {
    const file = path.resolve(path.dirname(bodyFile), target);
    if (!fs.existsSync(file)) fail(`${target} is referenced in the body but ${file} does not exist`);
    const form = new FormData();
    form.append('attachment', new Blob([fs.readFileSync(file)], { type: MIME[path.extname(file).toLowerCase()] || 'application/octet-stream' }), path.basename(file));
    const response = await fetch(`${origin}/api/v1/repos/${owner}/${name}/issues/${parsed.pr}/assets`, {
      method: 'POST',
      headers: { Authorization: `token ${token}`, Accept: 'application/json' },
      body: form,
    });
    if (!response.ok) fail(`uploading ${target} failed: ${response.status} ${(await response.text()).slice(0, 300)}`);
    const { browser_download_url: url } = await response.json();
    body = body.split(`](${target})`).join(`](${url})`);
  }
  process.stdout.write(body);
}

async function main() {
  if (Number(process.versions.node.split('.')[0]) < 20) fail(`needs Node 20 or newer, found ${process.versions.node}`, 3);
  const [command, ...rest] = process.argv.slice(2);
  if (command === 'record') return record(options(rest));
  if (command === 'forgejo-attach') return forgejoAttach(options(rest));
  fail(usage, 2);
}

main().catch((error) => fail(error.stack || String(error)));
